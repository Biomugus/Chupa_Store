# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# Каналы уведомлений и их настройка — docs/modules/notifications.md.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: обходит RLS, только сервер (запись orders / feedback_requests)
SUPABASE_SERVICE_ROLE_KEY=

# --- DaData (подсказки городов в чекауте) ---
DADATA_API_KEY=

# --- Уведомления о заказах и обращениях ---
# Канал включается, когда заданы все его переменные; незаданный канал пропускается.

# Telegram-бот: токен от @BotFather и id чата (у групп — отрицательный)
TG_BOT_TOKEN=
TG_CHAT_ID=

# VK: ключ сообщества с правом «Сообщения сообщества»;
# получатели через запятую — id страниц основателей или peer_id беседы (2000000001, …)
VK_GROUP_TOKEN=
VK_NOTIFY_PEER_IDS=

# Почта: SMTP рабочего ящика (пароль приложения, не основной пароль)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Получатели через запятую
NOTIFY_EMAIL_TO=
